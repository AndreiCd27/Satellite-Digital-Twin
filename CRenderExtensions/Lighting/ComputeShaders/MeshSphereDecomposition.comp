#version 430 core

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

uniform sampler3D VoxelTex;
uniform isampler3D InstanceTex;
uniform int LODmax;

struct Sphere {
    vec4 pos_rad; 
    ivec4 instanceID;
};

layout(std430, binding = 0) buffer SphereBuffer {
    uint sphereCount;
    uint pad0; uint pad1; uint pad2;
    Sphere spheres[];
};

int GetInstance(ivec3 minPos, int size, ivec3 gridRes) {
    ivec3 center = clamp(minPos + ivec3(size / 2), ivec3(0), gridRes - 1);
    int id = texelFetch(InstanceTex, center, 0).r;
    if (id >= 0) return id;
    return texelFetch(InstanceTex, clamp(minPos, ivec3(0), gridRes - 1), 0).r;
}

void main() {
    ivec3 gridRes = textureSize(InstanceTex, 0); 
    ivec3 voxelPos = ivec3(gl_GlobalInvocationID);
    if (voxelPos.x >= gridRes.x || voxelPos.y >= gridRes.y || voxelPos.z >= gridRes.z) return;

    float baseFill = texelFetch(VoxelTex, voxelPos, 0).r;
    if (baseFill <= 0.05) return; 

    int targetLOD = 0;
    ivec3 targetMinPos = voxelPos;
    float finalFill = baseFill;

    // Prag de merge conservator. Îl coborâm ușor la 0.45 pentru a forța 
    // clădirile să se compacteze în blocuri solide fără găuri interne.
    const float MERGE_THRESHOLD = 0.45; 

    for (int lod = LODmax; lod >= 1; lod--) { // Coborâm până la LOD 1 inclusiv
        int size = 1 << lod;
        ivec3 lodMinPos = (voxelPos / size) * size;
        
        // CORECTIE: Folosim texelFetch direct pe nivelul de mipmap (LOD) respectiv, 
        // în loc de textureLod, pentru a evita interpolarea hardware care dilua valorile clădirilor.
        ivec3 lodVoxelCoord = lodMinPos >> lod; 
        float mipFill = texelFetch(VoxelTex, lodVoxelCoord, lod).r;

        if (mipFill >= MERGE_THRESHOLD) {
            targetLOD = lod;
            targetMinPos = lodMinPos;
            finalFill = mipFill;
            break; 
        }
    }

    // Doar thread-ul din originea cubului compactat scrie sfeera
    if (voxelPos == targetMinPos) {
        int instanceID = GetInstance(targetMinPos, 1 << targetLOD, gridRes);
        
        if (instanceID >= 0) {
            uint idx = atomicAdd(sphereCount, 1);
            
            if (idx < 100000) {
                int currentSize = 1 << targetLOD;
                vec3 centerVoxel = vec3(targetMinPos) + vec3(float(currentSize) * 0.5);
                vec3 normCoord = centerVoxel / vec3(gridRes);

                // CORECTIE RADIALĂ: Pentru umbre continue (fără dispersie), raza sferei
                // trebuie să acopere complet diagonala cubului voxelului în spațiul normalizat.
                // Factorul ideal pentru a înscrie un cub într-o sferă este sqrt(3) / 2 ≈ 0.866.
                // Folosim un multiplicator conservator de 0.75-0.85 pentru a forța suprapunerea sferelor vecine.
                float radius = (float(currentSize) / float(gridRes.x)) * 0.75;

                // Dacă gradul de umplere e foarte mare, mărim sfera ca să fim siguri că nu lasă crăpături
                if (finalFill > 0.75) {
                    radius *= 1.1; 
                }

                spheres[idx].pos_rad = vec4(normCoord, radius);
                spheres[idx].instanceID = ivec4(instanceID, 0, 0, 0);
            }
        }
    }
}
